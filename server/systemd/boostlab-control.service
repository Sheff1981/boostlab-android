[Unit]
Description=BOOSTLAB control API
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/boostlab/server
EnvironmentFile=/etc/boostlab/control.env
ExecStart=/usr/bin/python3 /opt/boostlab/server/control_api.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
